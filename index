<script>
// Independent fallback: the age buttons keep working even if app.js has another error.
(function(){
  var gate=document.getElementById('ageGate');
  var yes=document.getElementById('ageYes');
  var no=document.getElementById('ageNo');
  if(yes) yes.addEventListener('click',function(){try{sessionStorage.setItem('vm_age_confirmed','1')}catch(e){} if(gate)gate.remove()});
  if(no) no.addEventListener('click',function(){document.body.innerHTML='<main style="font-family:Tahoma;text-align:center;padding:15vh 8vw;line-height:2"><h2>دسترسی امکان‌پذیر نیست</h2><p>این فروشگاه برای افراد واجد شرایط سنی است.</p></main>'});
  try{if(sessionStorage.getItem('vm_age_confirmed')&&gate)gate.remove()}catch(e){}
})();
</script>
